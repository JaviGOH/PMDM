<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mi_nombre"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonContinuar"
        style="@style/BotonTarea"
        android:layout_width="wrap_content"
        android:layout_marginEnd="38dp"
        android:text="@string/boton_continuar"
        app:layout_constraintEnd_toStartOf="@+id/buttonCancelar"
        app:layout_constraintTop_toBottomOf="@+id/textNombre"
        app:backgroundTint="@color/verde_continuar"/>

    <Button
        android:id="@+id/buttonCancelar"
        style="@style/BotonTarea"
        android:layout_width="wrap_content"
        android:layout_marginEnd="40dp"
        android:text="@string/boton_cancelar"
        app:backgroundTint="@color/rojo_cancelar"
        app:layout_constraintBaseline_toBaselineOf="@+id/buttonContinuar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>